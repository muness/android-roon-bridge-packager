<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The whole point of the app. Android forbids executing a file out of an
      app's data directory, but an app may write an APK and hand it to
      PackageInstaller, and the installer extracts that APK's
      lib/arm64-v8a/lib*.so entries into the installed app's library directory,
      where they are executable. The user still confirms every install on the
      platform's own screen.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="io.github.muness.roonbridge" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PackService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".EndpointInstaller$StatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.muness.roonpackager.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
